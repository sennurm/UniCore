# UniCore backend environment (copy to .env for local overrides)

# UNICORE_ENVIRONMENT=dev
# UNICORE_DATABASE_URL=postgresql+asyncpg://unicore:unicore@localhost:5432/unicore
# UNICORE_REDIS_URL=redis://localhost:6379/0

# Dev/test convenience ONLY: skip the OTP stage of login. The app refuses to
# start with this false when UNICORE_ENVIRONMENT=production (AUTH locked
# decision #1: password + OTP is mandatory in production).
# UNICORE_OTP_LOGIN_ENABLED=false
